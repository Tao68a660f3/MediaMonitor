<Project Sdk="Microsoft.NET.Sdk">

  <!--
    New Protocol V1.1 编解码层自测（实施计划 §4.2）

    * 不加入 MediaMonitor.sln，不影响正常构建；
    * 直接"链接"编解码层的源文件（而不是引用 WinExe 工程），因此不依赖 WPF；
    * 运行：dotnet run -c Debug
    * bin/ obj/ 已被仓库根 .gitignore 的 [Bb]in/ [Oo]bj/ 覆盖
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>NewProtocolSelfTest</AssemblyName>
    <RootNamespace>NewProtocolSelfTest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\MediaMonitor_App\Protocol\New\Codec\*.cs" LinkBase="Codec" />
    <Compile Include="..\..\MediaMonitor_App\Protocol\New\Transport\INewTransport.cs" LinkBase="Transport" />
    <Compile Include="..\..\MediaMonitor_App\Protocol\New\Transport\TcpTransport.cs" LinkBase="Transport" />
    <Compile Include="..\..\MediaMonitor_App\Protocol\New\Service\NewSendScheduler.cs" LinkBase="Service" />
    <Compile Include="..\..\MediaMonitor_App\Protocol\New\Service\SessionManager.cs" LinkBase="Service" />
    <Compile Include="..\..\MediaMonitor_App\Protocol\New\Service\MediaPublisher.cs" LinkBase="Service" />
    <Compile Include="..\..\MediaMonitor_App\Protocol\New\Service\TimelinePump.cs" LinkBase="Service" />
    <Compile Include="..\..\MediaMonitor_App\Protocol\New\Service\ControlReceiver.cs" LinkBase="Service" />
    <Compile Include="..\..\MediaMonitor_App\Protocol\New\Service\ResourceSender.cs" LinkBase="Service" />
    <Compile Include="..\..\MediaMonitor_App\Protocol\New\Service\LyricResourceBuilder.cs" LinkBase="Service" />
    <Compile Include="..\..\MediaMonitor_App\Protocol\New\Service\ArtworkResourceBuilder.cs" LinkBase="Service" />
    <Compile Include="..\..\MediaMonitor_App\Protocol\New\Service\LatencyManager.cs" LinkBase="Service" />
    <!-- 业务数据源（纯逻辑，无 WPF 依赖）：歌词解析 + Legacy 帧构造 + 封面重编码 -->
    <Compile Include="..\..\MediaMonitor_App\Services\LyricService.cs" LinkBase="App" />
    <Compile Include="..\..\MediaMonitor_App\Tools\PackageBuilder.cs" LinkBase="App" />
    <Compile Include="..\..\MediaMonitor_App\Tools\ArtworkProcessor.cs" LinkBase="App" />
    <!-- 注意：SmtcTimelineSource.cs 不链接（它依赖 WPF 应用里的 SmtcService） -->
  </ItemGroup>

</Project>
